{
  "extends": [
    "standard",
    "plugin:@typescript-eslint/recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "project": [
      "./backend/tsconfig.json",
      "./frontend/tsconfig.json"
    ]
  },
  "plugins": [
    "@typescript-eslint"
  ],
  "ignorePatterns": [
    "jest.config.js",
    "jest.config.ts",
    "vite.config.ts",
    "tailwind.config.js",
    "db/"
  ]
}